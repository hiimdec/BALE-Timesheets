<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Widget-extension entitlements. MUST list the SAME App Group as the App target
  so the two processes share storage. Add the "App Groups" capability to the
  TimeMachineWidget target in Xcode and tick group.co.uk.timemachineapp.shared.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.co.uk.timemachineapp.shared</string>
	</array>
</dict>
</plist>
